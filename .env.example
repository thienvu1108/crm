PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
# 32 random bytes, encoded as base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails allowed to administer the platform.
PLATFORM_ADMIN_EMAILS=
# Secret bearer token for an external scheduler calling POST /api/jobs/backups
JOB_SECRET=
NODE_ENV=development

# Meta / Facebook Page (Messenger). Optional until you connect a Fanpage.
META_APP_ID=
META_APP_SECRET=
# Verify token configured in Meta App → Webhooks (must match exactly).
META_WEBHOOK_VERIFY_TOKEN=

# Zalo Official Account Open API. Optional until you connect an OA.
ZALO_APP_ID=
ZALO_APP_SECRET=
# Optional fallback OA secret for webhook MAC if not stored per connection.
ZALO_OA_SECRET=
